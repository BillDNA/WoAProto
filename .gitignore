# Obsidian workspace (local editor state)
.obsidian/

# dev harness dependencies (jsdom for dev/smoke.js) and scratch screenshots
dev/node_modules/
dev/package*.json
dev/*.png

# Windows cruft
desktop.ini
Thumbs.db

# Art source binaries stay local (public repo, big files) — optimize-art.ps1's originals sink.
# (The HexClarificationDiagram the terrain rules are defined by is tracked under docs/.)
dev/art-originals/

# Playtest reports live under logs/reports/ (Feedback Round 4). The balance +
# skirmish .md reports ARE the corpus the report skills read, so they're tracked;
# only the append-only master log, live scratch log, and debug-state dumps are
# noise — ignored.
logs/reports/skirmish/claude-plays-log.jsonl
logs/reports/skirmish/run-live.log
logs/debug/*
!logs/debug/.gitkeep
dev/claude-plays-log.jsonl

# V1 skirmish database — a regenerable index over the committed reports (Bill's
# ruling: gitignore for now). WAL mode adds -wal/-shm siblings.
logs/woa.db
logs/woa.db-wal
logs/woa.db-shm

# Author feed (#165): the card Author's per-run record of what it add/edit/removed,
# regenerated every run (like woa.db). The committed content/cards files + markdown
# reports are the durable artifacts; the Workbench reads this live from the last run.
logs/authored/

# DynamicScrum — per-machine/ephemeral (statusLine readout, local settings, hub mutation log)
.claude-status
.claude/settings.local.json
.board-log.jsonl


# graphify knowledge graph — regenerable local index (nodes/edges via `graphify update .`,
# no LLM; community label names via `graphify label`). Kept fresh by the post-commit hook;
# not tracked, to keep the multi-MB wholesale rebuild churn out of history.
graphify-out/
