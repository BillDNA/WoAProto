# Obsidian workspace (local editor state)
.obsidian/

# dev harness dependencies (jsdom for dev/smoke.js) and scratch screenshots
dev/node_modules
dev/package*.json
dev/*.png

# Windows cruft
desktop.ini
Thumbs.db

# Art source binaries stay local (public repo, big files) — optimize-art.ps1's originals sink.
# (The HexClarificationDiagram the terrain rules are defined by is tracked under docs/.)
dev/art-originals/

# Playtest reports live under logs/reports/ (see logs/README.md). The committed
# .md reports are the gameplay/content corpus the report skills read; the
# append-only master log, live scratch log, and debug-state dumps are noise —
# ignored.
logs/reports/skirmish/claude-plays-log.jsonl
logs/reports/skirmish/run-live.log
logs/reports/skirmish/.typicality-cache.json
logs/debug/*
!logs/debug/.gitkeep
dev/claude-plays-log.jsonl

# Skirmish database — a regenerable index over the reports; gitignored. WAL mode
# adds -wal/-shm siblings.
logs/woa.db
logs/woa.db-wal
logs/woa.db-shm

# Throwaway refactor/balance baselines — generated on demand, diffed before/after
# a refactor, then discarded (ADR-0005; never committed, never gated). The dir is
# tracked via its README so the path always exists; everything else dropped in it
# is ignored, so a forgotten baseline can never leak into main.
dev/baselines/*
!dev/baselines/README.md

# DynamicScrum — per-machine/ephemeral (statusLine readout, local settings, hub mutation log)
.claude-status
.claude/settings.local.json
.board-log.jsonl


# graphify knowledge graph — the map is committed per-project so every clone/worktree
# starts with it. manifest.json is the incremental cache: its keys are repo-relative
# and re-anchored on load, so committing it is what stops a fresh checkout doing a full
# rebuild. The labels sidecar travels with its .sig: re-clustering reassigns community
# ids, and the signature is what lets a rebuild detect that and re-derive a stale name
# instead of trusting it. Still excluded: the regenerable viewer, the cache, dated
# snapshots, cost accounting, and .graphify_python (a machine-local interpreter path).
graphify-out/*
!graphify-out/graph.json
!graphify-out/manifest.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_labels.json.sig
!graphify-out/.graphify_root
